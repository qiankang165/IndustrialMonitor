<Window x:Class="IndustrialMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工业数据采集监控系统" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 工具栏 -->
            <RowDefinition Height="*"/>
            <!-- 主内容 -->
            <RowDefinition Height="Auto"/>
            <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ========== 顶部工具栏 ========== -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Label Content="串口:" Foreground="White" FontWeight="Bold" Margin="0,0,5,0"/>
                <ComboBox x:Name="cmbPorts" Width="120" Margin="0,0,10,0" 
                          ItemsSource="{Binding PortNames}" 
                          SelectedItem="{Binding SelectedPort}"/>
                <Button x:Name="btnConnect" Content="打开串口" Width="100" Height="30"
                        Background="#27AE60" Foreground="White" FontWeight="Bold"
                        Click="BtnConnect_Click" Margin="0,0,10,0"/>
                <Button x:Name="btnRefresh" Content="刷新" Width="80" Height="30"
                        Background="#3498DB" Foreground="White" FontWeight="Bold"
                        Click="BtnRefresh_Click"/>
                <Button x:Name="btnRead" Content="读取数据" Width="100" Height="30"
        Background="#F39C12" Foreground="White" FontWeight="Bold"
        Click="BtnRead_Click" Margin="0,0,10,0"/>
                <Label Content="设备数: 0" x:Name="lblDeviceCount" Foreground="White" Margin="30,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ========== 主内容区域 ========== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- 设备列表 -->
                <ColumnDefinition Width="1.5*"/>
                <!-- 日志窗口 -->
            </Grid.ColumnDefinitions>

            <!-- 设备列表 -->
            <Border Grid.Column="0" Background="#ECF0F1" CornerRadius="5" Padding="10" Margin="0,0,5,0">
                <StackPanel>
                    <Label Content="📡 设备列表" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                    <ListBox x:Name="lstDevices" Height="Auto" 
                             ItemsSource="{Binding Devices}" 
                             DisplayMemberPath="Name"
                             Background="White" BorderBrush="#BDC3C7"/>

                    <Label Content="📊 寄存器数据" FontWeight="Bold" FontSize="14" Margin="0,10,0,5"/>
                    <ListBox x:Name="lstData" Height="150" Background="White" BorderBrush="#BDC3C7"
         ItemsSource="{Binding RegisterValues}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="border" Background="Transparent" Padding="2" Margin="0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Address}" Width="80" FontWeight="Bold"/>
                                        <TextBlock Text=": " />
                                        <TextBlock Text="{Binding Value}" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasChanged}" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FFE5B4"/>
                                        <!-- 浅橙色 -->
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            
            
            <!-- 日志窗口 -->
            <Border Grid.Column="1" Background="#ECF0F1" CornerRadius="5" Padding="10" Margin="5,0,0,0">
                <StackPanel>
                    <Label Content="📋 通信日志" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtLog" Height="Auto" 
                             Background="White" 
                             TextWrapping="Wrap" 
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========== 底部状态栏 ========== -->
        <Border Grid.Row="2" Background="#34495E" Padding="10" CornerRadius="5" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Label x:Name="lblStatus" Content="⚪ 未连接" Foreground="#E74C3C" FontWeight="Bold"/>
                <Label x:Name="lblRecvCount" Content="接收: 0 字节" Foreground="White" Margin="30,0,0,0"/>
                <Label x:Name="lblSendCount" Content="发送: 0 字节" Foreground="White" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>