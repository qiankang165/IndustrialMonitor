<Window x:Class="IndustrialMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="工业数据采集监控系统" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 工具栏 -->
            <RowDefinition Height="*"/>
            <!-- 主内容 -->
            <RowDefinition Height="Auto"/>
            <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ========== 顶部工具栏 ========== -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Label Content="串口:" Foreground="White" FontWeight="Bold" Margin="0,0,5,0"/>
                <ComboBox x:Name="cmbPorts" Width="120" Margin="0,0,10,0" 
                          ItemsSource="{Binding PortNames}" 
                          SelectedItem="{Binding SelectedPort}"/>
                <Button x:Name="btnConnect" Content="打开串口" Width="100" Height="30"
                        Background="#27AE60" Foreground="White" FontWeight="Bold"
                        Click="BtnConnect_Click" Margin="0,0,10,0"/>
                <Button x:Name="btnRefresh" Content="刷新串口" Width="80" Height="30"
                        Background="#3498DB" Foreground="White" FontWeight="Bold"
                        Click="BtnRefresh_Click" Margin="0,0,10,0"/>
                <Button x:Name="btnRead" Content="读取数据" Width="100" Height="30"
        Background="#F39C12" Foreground="White" FontWeight="Bold"
        Click="BtnRead_Click" Margin="0,0,10,0"/>
                <Label Content="设备数: 0" x:Name="lblDeviceCount" Foreground="White" Margin="30,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ========== 主内容区域 ========== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- 设备列表 -->
                <ColumnDefinition Width="1.5*"/>
                <!-- 日志窗口 -->
            </Grid.ColumnDefinitions>

            <!-- 设备列表 -->
            <Border Grid.Column="0" Background="#ECF0F1" CornerRadius="5" Padding="10" Margin="0,0,5,0">
                <!-- 设备数据区域 -->
                <StackPanel>
                    <Label Content="📊 设备数据" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

                    <!-- 设备1 -->
                    <Border Background="#F0F4F8" CornerRadius="5" Padding="5" Margin="0,0,0,5">
                        <StackPanel>
                            <Label Content="设备 1 (地址: 01)" FontWeight="Bold" FontSize="13"/>
                            <ListBox ItemsSource="{Binding Devices[0].Registers}" Height="80">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="border" Background="Transparent" Padding="2" Margin="0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Address}" Width="60"/>
                                                <TextBlock Text=": "/>
                                                <TextBlock Text="{Binding Value}" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasChanged}" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FFE5B4"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- 设备2 -->
                    <Border Background="#F0F4F8" CornerRadius="5" Padding="5" Margin="0,0,0,5">
                        <StackPanel>
                            <Label Content="设备 2 (地址: 02)" FontWeight="Bold" FontSize="13"/>
                            <ListBox ItemsSource="{Binding Devices[1].Registers}" Height="80">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="border" Background="Transparent" Padding="2" Margin="0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Address}" Width="60"/>
                                                <TextBlock Text=": "/>
                                                <TextBlock Text="{Binding Value}" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasChanged}" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FFE5B4"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- 设备3 -->
                    <Border Background="#F0F4F8" CornerRadius="5" Padding="5" Margin="0,0,0,5">
                        <StackPanel>
                            <Label Content="设备 3 (地址: 03)" FontWeight="Bold" FontSize="13"/>
                            <ListBox ItemsSource="{Binding Devices[2].Registers}" Height="80">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="border" Background="Transparent" Padding="2" Margin="0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Address}" Width="60"/>
                                                <TextBlock Text=": "/>
                                                <TextBlock Text="{Binding Value}" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasChanged}" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FFE5B4"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                    
                    
                </StackPanel>
                
            </Border>



            <!-- 日志窗口 -->
            <!-- 日志窗口 -->
            <Border Grid.Column="1" Background="#ECF0F1" CornerRadius="5" Padding="10" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 标题 -->
                        <RowDefinition Height="*"/>
                        <!-- 日志（占满剩余空间） -->
                        <RowDefinition Height="Auto"/>
                        <!-- 历史趋势标题 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 下拉框 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 曲线图 -->
                    </Grid.RowDefinitions>

                    <!-- 日志标题 -->
                    <Label Grid.Row="0" Content="📋 通信日志" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

                    <!-- 日志文本框（带滚动条，自动撑满） -->
                    <TextBox x:Name="txtLog" Grid.Row="1"
                 Background="White" 
                 TextWrapping="Wrap" 
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"/>

                    <!-- 历史趋势标题 -->
                    <Label Grid.Row="2" Content="📈 历史趋势" FontWeight="Bold" FontSize="14" Margin="0,10,0,5"/>

                    <!-- 下拉框（设备和寄存器选择） -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                        <Label Content="设备:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbDeviceForChart" Width="80" Margin="5,0,10,0" SelectedIndex="0">
                            <ComboBoxItem Content="设备1" Tag="1"/>
                            <ComboBoxItem Content="设备2" Tag="2"/>
                            <ComboBoxItem Content="设备3" Tag="3"/>
                        </ComboBox>
                        <Label Content="寄存器:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbRegisterForChart" Width="80" Margin="5,0,10,0" SelectedIndex="0">
                            <ComboBoxItem Content="寄存器0" Tag="0"/>
                            <ComboBoxItem Content="寄存器1" Tag="1"/>
                            <ComboBoxItem Content="寄存器2" Tag="2"/>
                        </ComboBox>
                        <Button Content="刷新曲线" Width="80" Height="28" Click="BtnRefreshChart_Click"/>
                    </StackPanel>

                    <!-- 曲线图 -->
                    <lvc:CartesianChart x:Name="chartHistory" Grid.Row="4" Height="180">
                        <!-- 不在 XAML 里定义 Series，由代码动态添加 -->
                    </lvc:CartesianChart>
                </Grid>
            </Border>
        </Grid>

        <!-- ========== 底部状态栏 ========== -->
        <Border Grid.Row="2" Background="#34495E" Padding="10" CornerRadius="5" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Label x:Name="lblStatus" Content="⚪ 未连接" Foreground="#E74C3C" FontWeight="Bold"/>
                <Label x:Name="lblRecvCount" Content="接收: 0 字节" Foreground="White" Margin="30,0,0,0"/>
                <Label x:Name="lblSendCount" Content="发送: 0 字节" Foreground="White" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>